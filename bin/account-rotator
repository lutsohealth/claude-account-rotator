#!/usr/bin/env python3
"""account-rotator: the account-rotator mod's Claude accounts from a shell, in the words of Orca's `orca account`.

    account-rotator account list [--agent claude] [--json] [--store PATH]
    account-rotator account select --account <id|email|system> [--agent claude] [--wait S] [--json] [--store PATH]
    account-rotator account use --account <id|email|system> [--agent claude] [--wait S] [--json] [--store PATH]
    account-rotator account rm --account <id|email> [--agent claude] [--wait S] [--json] [--store PATH]
    account-rotator account add [--folder PATH] [--agent claude] [--wait S] [--json] [--store PATH]

`list` prints each account's row as the switcher pane draws it, from the store's `rows` key, which every session of
the mod rewrites when a row changes: its times are stored as instants, rendered here at this clock and in this zone.
Then one line says when the rows were written and which account new sessions start on.

`select` sets the account new sessions start on, as the panel's New on does. `use` moves the session running it, as
Use now does. `rm` signs an account out and drops it, as Remove does. No verb writes the store: these three leave a
request file in the Claude config folder's account-rotator-requests, naming the store's `store-id`; a session of the
mod on that store applies it and answers with a result file. `use` also names the session, by the mark the mod sets in
its Bash children's environment.

`add` signs a new folder in, in this terminal, then asks in the same way for a session to list it.
"""

# Read as text, so `str | None` is no error on a macOS python3 older than 3.10.
from __future__ import annotations

import argparse
import json
import math
import os
import re
import signal
import subprocess
import sys
import time
import uuid
from datetime import tzinfo

# The store module stands beside this file. Run as a script, Python puts the file's own folder first on sys.path,
# links resolved; this line is for a loader that does not, such as the tests' in-process import.
sys.path.insert(0, os.path.dirname(__file__))
from account_rotator_store import STORE_GLOB, StoreError, clock_text, is_instant, read, requests_folder, same_pick_since  # noqa: E402

EXIT_NO_STORE = 1
EXIT_USAGE = 2
EXIT_NO_SESSION = 3
EXIT_REFUSED = 4
EXIT_NO_SIGN_IN = 5
EXIT_CANCELLED = 130
MINUTE_MS = 60_000
POLL_S = 0.25
# hooks/model.ts REQUEST_TTL_MS: past it no session takes a request, so --wait stops there.
REQUEST_TTL_S = 300
# A request's own file names: hooks/model.ts NONCE, then what `ask` and a session write.
LEFTOVER = re.compile(r"[A-Za-z0-9-]{6,64}\.(json|result\.json|json\.tmp)")
# hooks/register.tsx setSessionMark: the mark a session of the mod sets in its Bash children's environment.
SESSION_VAR = "ACCOUNT_ROTATOR_SESSION"
# The slot a session runs on, which the mod keeps set in its Bash children's environment: unset is Claude Code's login.
SLOT_VAR = "CLAUDE_SECURESTORAGE_CONFIG_DIR"
OLDER_NOTE = "an older version of the mod stored some rows as text, their times as of when it wrote them"
EXITS = (
    "Exit 0 done, 1 no store or a damaged one or a folder or request it cannot write, 2 a usage error (an unknown flag or verb, --agent not claude, an --account"
    " that names no account or several, a --wait not above 0 and at most 300, use outside a session of the mod, rm of Claude Code's own login, add with no terminal,"
    " a --folder that names no numbered folder under the accounts folder), 3 no session took the request within --wait, or none"
    " has given the store a store-id yet, 4 a session refused it, 5 the sign-in did not finish, 130 stopped, the request withdrawn."
)


class UsageError(Exception):
    """A usage error the bin answers with one stderr line and exit 2."""


def is_run(run: object) -> bool:
    """Whether a stored run is one the mod writes: text, or one {clock} or {until} instant."""
    if isinstance(run, str):
        return True
    return isinstance(run, dict) and len(run) == 1 and any(is_instant(run.get(key)) for key in ("clock", "until"))


def check(data: dict, path: str) -> None:
    """Every value `list` reads, by type and range; a StoreError names the first the mod would never write."""

    def damaged(what: str) -> StoreError:
        return StoreError(f"{path}: {what}, which the mod never writes; a session rewrites it within a minute, or pass --store")

    for n, account in enumerate(data["accounts"]):
        if not isinstance(account, dict) or not isinstance(account.get("id"), str):
            raise damaged(f"accounts[{n}] is no account with an id")
    stored = data.get("rows")
    if stored is not None:
        if not isinstance(stored, dict) or not isinstance(stored.get("rows"), list):
            raise damaged("rows holds no rows list")
        if "at" in stored and not is_instant(stored["at"]):
            raise damaged("rows.at is no time")
        for row in stored["rows"]:
            if not isinstance(row, dict) or not isinstance(row.get("id"), str) or not isinstance(row.get("lines"), list):
                raise damaged("a row has no id or no lines")
            if not all(isinstance(line, str) or (isinstance(line, list) and all(map(is_run, line))) for line in row["lines"]):
                raise damaged(f"row {row['id']} holds a line of no known shape")
    pick = data.get("launch-slot")
    if pick is not None and (not isinstance(pick, dict) or ("at" in pick and not is_instant(pick["at"]))):
        raise damaged("launch-slot is no pick")


def reset_text(at_ms: float, now_ms: float) -> str:
    """The time until `at_ms`, as hooks/model.ts resetText says it, a half minute rounded up as JavaScript rounds."""
    minutes = max(0, math.floor((at_ms - now_ms) / MINUTE_MS + 0.5))
    days, hours, mins = minutes // 1440, minutes % 1440 // 60, minutes % 60
    if days > 0:
        return f"{days}d {hours}h {mins}m"
    return f"{hours}h {mins}m" if hours > 0 else f"{mins}m"


def line_text(line: str | list, now_ms: float, zone: tzinfo | None) -> str:
    """A stored line as text: a string line as it was stored (its characters are its runs); else its runs, each {clock}
    and {until} rendered, and an {until} already past as `passed` (hooks/model.ts storedLineText)."""
    text = []
    for run in line:
        if isinstance(run, str):
            text.append(run)
        elif "clock" in run:
            text.append(clock_text(run["clock"], zone))
        else:
            text.append(reset_text(run["until"], now_ms) if run["until"] > now_ms else "passed")
    return "".join(text)


def has_passed(line: str | list, now_ms: float) -> bool:
    return isinstance(line, list) and any(isinstance(run, dict) and run.get("until", math.inf) <= now_ms for run in line)


def who(account: dict) -> str:
    """The account's name on its row's first line: hooks/model.ts rowOf."""
    if isinstance(account.get("email"), str):
        return account["email"]
    return "your normal account" if account.get("slot") == "" else "not signed in yet"


def account_lines(account: dict, rows: dict[str, list], now_ms: float, zone: tzinfo | None) -> tuple[list[str], bool, bool]:
    """An account's lines, whether an older version of the mod stored them, and whether a reset in them has passed."""
    stored = rows.get(account["id"])
    if not stored:
        return [f"{who(account)}  no row stored yet"], False, False
    lines = [line_text(line, now_ms, zone) for line in stored]
    return lines, any(isinstance(line, str) for line in stored), any(has_passed(line, now_ms) for line in stored)


def minutes_ago(at_ms: object, now_ms: float) -> str:
    return f"{round((now_ms - at_ms) / MINUTE_MS)} min ago" if is_instant(at_ms) else "at an unknown time"


def footer(data: dict, now_ms: float, zone: tzinfo | None, older: bool, passed: list[str]) -> str:
    """When the rows were written, and which account new sessions start on, as bin/account-rotator-launch words it."""
    stored = data.get("rows")
    at = stored.get("at") if isinstance(stored, dict) else None
    written = f"rows written {clock_text(at, zone)} ({minutes_ago(at, now_ms)})" if is_instant(at) else "no session has stored rows yet"
    pick = data.get("launch-slot")
    if isinstance(pick, dict) and isinstance(pick.get("id"), str):
        since = same_pick_since(pick.get("at"), zone)
        starts = f"new sessions start on account {pick['id']} ({pick.get('why', 'the setting picked it')}{', ' + since if since else ''})"
    else:
        starts = "no account picked for new sessions"
    notes = [OLDER_NOTE] if older else []
    if passed:
        notes.append(f"a reset has passed since its row was written for account {', '.join(passed)}: no session has read it since, so its usage is as before the reset")
    return "; ".join([written, starts, *notes])


def rows_by_id(data: dict) -> dict[str, list]:
    stored = data.get("rows")
    return {r["id"]: r["lines"] for r in stored["rows"]} if isinstance(stored, dict) else {}


def listed(data: dict, now_ms: float, zone: tzinfo | None) -> list[tuple[dict, list[str], bool, bool]]:
    rows = rows_by_id(data)
    return [(a, *account_lines(a, rows, now_ms, zone)) for a in data["accounts"]]


def list_text(data: dict, now_ms: float, zone: tzinfo | None) -> str:
    accounts = listed(data, now_ms, zone)
    blocks = ["\n".join(lines) for _, lines, _, _ in accounts]
    passed = [a["id"] for a, _, _, has in accounts if has]
    return "\n\n".join([*blocks, footer(data, now_ms, zone, any(older for _, _, older, _ in accounts), passed)])


def this_session_account(data: dict) -> str | None:
    """The account whose slot this process inherited from a session of the mod: none with no mark inherited. A child
    that outlives its session keeps both, and nothing here can tell; a session registry is out of the epic's scope."""
    if not os.environ.get(SESSION_VAR):
        return None
    slot = os.environ.get(SLOT_VAR, "")
    return next((a["id"] for a in data["accounts"] if a.get("slot") == slot), None)


def list_json(data: dict, store: str, now_ms: float, zone: tzinfo | None) -> dict:
    """Orca's envelope (`orca account list --json`), with the mod's own fields per account."""
    accounts = []
    rows = rows_by_id(data)
    for a, lines, older, passed in listed(data, now_ms, zone):
        health = data.get(f"health:{a['id']}")
        has_row = bool(rows.get(a["id"]))
        accounts.append({
            "id": a["id"], "email": a.get("email"), "orgId": a.get("orgId"), "orgName": a.get("orgName"), "plan": a.get("plan"),
            "tier": a.get("tier"), "slot": a.get("slot"), "system": a.get("slot") == "",
            "health": health.get("kind") if isinstance(health, dict) else None, "lines": lines if has_row else [], "hasRow": has_row, "olderLines": older,
            "resetPassed": passed,
        })
    pick = data.get("launch-slot")
    active = pick.get("id") if isinstance(pick, dict) and isinstance(pick.get("id"), str) else None
    stored = data.get("rows")
    return {
        "id": str(uuid.uuid4()),
        "ok": True,
        "result": {
            "accounts": accounts, "activeAccountId": active, "activeAccountIdsByRuntime": {"host": active, "wsl": {}},
            "launchOn": data.get("launch-on"), "launchPick": pick, "thisSessionAccountId": this_session_account(data),
        },
        "_meta": {"runtimeId": None, "store": store, "rowsAt": stored.get("at") if isinstance(stored, dict) else None},
    }


def resolve(data: dict, given: str) -> str:
    """The id of the one account `--account` names: an id, `system` (the account on Claude Code's own login), or an
    email, which may name several accounts in several organizations."""
    accounts = data["accounts"]
    if any(a["id"] == given for a in accounts):
        return given
    if given == "system":
        found = [a["id"] for a in accounts if a.get("slot") == ""]
    else:
        found = [a["id"] for a in accounts if isinstance(a.get("email"), str) and a["email"].lower() == given.lower()]
    if len(found) == 1:
        return found[0]
    if found:
        raise UsageError(f"--account {given} names accounts {', '.join(found)}: pass one id")
    named = ", ".join(f"{a['id']} ({a['email']})" if isinstance(a.get("email"), str) else a["id"] for a in accounts)
    raise UsageError(f"--account {given} names no account; the accounts are {named}, or system")


def wait_seconds(text: str) -> float:
    """--wait: finite, above 0, at most the time a session takes a request; a NaN fails the comparison too."""
    value = float(text)
    if not 0 < value <= REQUEST_TTL_S:
        raise argparse.ArgumentTypeError(f"{text} is not above 0 and at most {REQUEST_TTL_S}")
    return value


def is_answer(found: object, nonce: str) -> bool:
    """Whether a result file's content answers this request: its own nonce, ok a bool, message a string."""
    return isinstance(found, dict) and found.get("nonce") == nonce and isinstance(found.get("ok"), bool) and isinstance(found.get("message"), str)


def answer(folder: str, nonce: str, wait_s: float) -> dict | None:
    """The result a session wrote for the request, waiting at most `wait_s`."""
    result = os.path.join(folder, f"{nonce}.result.json")
    deadline = time.monotonic() + wait_s
    while True:
        try:
            with open(result, encoding="utf-8") as f:
                found = json.load(f)
        except (OSError, ValueError):
            found = None
        if is_answer(found, nonce):
            return found
        if time.monotonic() >= deadline:
            return None
        time.sleep(POLL_S)


def cancelled(signum: int, _frame: object) -> None:
    """SIGTERM and SIGHUP stop the wait as Ctrl-C does, so `select`'s finally withdraws the request."""
    raise KeyboardInterrupt(signal.Signals(signum).name)


def sweep(folder: str) -> None:
    """Removes what a killed CLI or a dead session left: files of a request's own shape, past the time a request lasts.
    The session's fs has no delete, so this is the one remover. Nothing here fails the verb that called it."""
    try:
        names = os.listdir(folder)
    except OSError:
        return
    for name in filter(LEFTOVER.fullmatch, names):
        path = os.path.join(folder, name)
        try:
            if os.lstat(path).st_mtime < time.time() - REQUEST_TTL_S:
                os.remove(path)
        except OSError:
            pass


def ask(folder: str, request: dict, wait_s: float) -> dict | None:
    """Writes a request whole, by a rename, and waits for its answer; the request is withdrawn on every way out."""
    path = os.path.join(folder, f"{request['nonce']}.json")
    try:
        os.makedirs(folder, exist_ok=True)
        sweep(folder)
        with open(f"{path}.tmp", "w", encoding="utf-8") as f:
            json.dump(request, f)
        os.replace(f"{path}.tmp", path)
        return answer(folder, request["nonce"], wait_s)
    finally:
        for leftover in (f"{path}.tmp", path, os.path.join(folder, f"{request['nonce']}.result.json")):
            try:
                os.remove(leftover)
            except OSError:
                pass


def stop_on_signals() -> None:
    for signum in (signal.SIGTERM, signal.SIGHUP):
        signal.signal(signum, cancelled)


def no_store_id(store: str, way_back: str = "") -> int:
    print(f"account-rotator: {store} has no store-id: no session of this version of the mod has run on it; start one, then run again{way_back}", file=sys.stderr)
    return EXIT_NO_SESSION


def session_answer(store: str, store_id: str, account: str, wait_s: float, fields: dict, untaken: str, way_back: str = "") -> tuple[int, dict | None]:
    """Leaves a request for the sessions on this store, written whole by a rename, and waits. An ok answer comes back with
    0; any other way out is said here, `way_back` after it, and comes back as its exit code. `fields` are what the verb
    asks, `untaken` says who took it not."""
    stop_on_signals()
    folder, nonce = requests_folder(store), uuid.uuid4().hex
    try:
        result = ask(folder, {**fields, "nonce": nonce, "at": time.time() * 1000, "id": account, "store": store_id}, wait_s)
    except OSError as error:
        print(f"account-rotator: cannot write a request in {folder}: {error.strerror or error}{way_back}", file=sys.stderr)
        return EXIT_NO_STORE, None
    if result is None:
        print(f"account-rotator: {untaken} the request within {wait_s:g} s, so it is withdrawn; a session may have taken it in that same moment: run account list{way_back}", file=sys.stderr)
        return EXIT_NO_SESSION, None
    if not result["ok"]:
        print(f"account-rotator: a session refused: {result['message']}{way_back}", file=sys.stderr)
        return EXIT_REFUSED, None
    return 0, result


def report(store: str, result: dict, envelope: dict, as_json: bool) -> None:
    if as_json:
        print(json.dumps({"id": str(uuid.uuid4()), "ok": True, "result": envelope, "_meta": {"runtimeId": None, "store": store}}, indent=2))
    else:
        print(f"account-rotator: {result['message']}")


def request_session(data: dict, store: str, given: str, wait_s: float, as_json: bool, fields: dict, untaken: str, envelope_of) -> int:
    """Asks the sessions on this store about the account `given` names and reports the answer: `envelope_of(account,
    result)` is the verb's --json."""
    try:
        account = resolve(data, given)
    except UsageError as error:
        print(f"account-rotator: {error}", file=sys.stderr)
        return EXIT_USAGE
    store_id = data.get("store-id")
    if not isinstance(store_id, str):
        return no_store_id(store)
    code, result = session_answer(store, store_id, account, wait_s, fields, untaken)
    if result is not None:
        report(store, result, envelope_of(account, result), as_json)
    return code


def select(data: dict, store: str, given: str, wait_s: float, as_json: bool) -> int:
    """Asks the sessions on this store to set the account new sessions start on."""

    def envelope(account: str, result: dict) -> dict:
        pick = result.get("pickId") if isinstance(result.get("pickId"), str) else None
        return {"account": account, "activeAccountId": pick, "launchOn": f"account:{account}"}

    return request_session(data, store, given, wait_s, as_json, {"kind": "select"}, f"no session of the mod on {store} took", envelope)


def use(data: dict, store: str, given: str, wait_s: float, as_json: bool) -> int:
    """Asks the session running this to move to an account. A session answers while its Bash call runs, so a run of
    this in the Bash tool's foreground has its answer at once; any other way of running it, at that session's minute."""

    def envelope(account: str, result: dict) -> dict:
        here = result.get("activeId") if isinstance(result.get("activeId"), str) else None
        return {"account": account, "thisSessionAccountId": here, "message": result["message"]}

    fields = {"kind": "use", "session": os.environ[SESSION_VAR]}
    return request_session(data, store, given, wait_s, as_json, fields, f"the session that ran this, on {store}, did not take", envelope)


def remove(data: dict, store: str, given: str, wait_s: float, as_json: bool) -> int:
    """Asks the sessions on this store to sign an account out and drop it. Claude Code's own login is not the mod's."""
    try:
        account = resolve(data, given)
    except UsageError as error:
        print(f"account-rotator: {error}", file=sys.stderr)
        return EXIT_USAGE
    row = next(a for a in data["accounts"] if a["id"] == account)
    slot = row.get("slot")
    if not isinstance(slot, str):
        print(f"account-rotator: {store}: account {account} has no slot, which the mod never writes, so nothing is asked: fix the store by hand, or see --help", file=sys.stderr)
        return EXIT_NO_STORE
    if slot == "":
        print(f"account-rotator: account {account} is Claude Code's own login, which the mod does not remove: sign it out with claude auth logout, or see --help", file=sys.stderr)
        return EXIT_USAGE

    def envelope(_account: str, result: dict) -> dict:
        pick = result.get("pickId") if isinstance(result.get("pickId"), str) else None
        return {"account": account, "activeAccountId": pick, "message": result["message"]}

    # What this read saw: the session compares it before it signs anything out, as an id can change holder while a request waits.
    seen = {"slot": slot, **{key: row[key] for key in ("email", "orgId") if isinstance(row.get(key), str)}}
    return request_session(data, store, account, wait_s, as_json, {"kind": "rm", **seen}, f"no session of the mod on {store} took", envelope)


def accounts_folder() -> str:
    """Where the mod keeps each account's folder, whichever config folder a session runs on: hooks/register.tsx addAccount."""
    return os.path.join(os.path.expanduser("~"), ".claude", "accounts")


def folder_given(given: str) -> str:
    """The folder `--folder` names, as a session compares it: a numbered one that exists under the accounts folder."""
    path, root = os.path.abspath(given), accounts_folder()
    if os.path.dirname(path) != root or not re.fullmatch(r"[1-9][0-9]*", os.path.basename(path)) or not os.path.isdir(path) or os.path.islink(path):
        raise UsageError(f"--folder {given} names no numbered folder that exists under {root}, and no link passes: pass one, or see --help")
    return path


def make_folder(data: dict) -> str:
    """Makes the next free folder: the first number from 2 with no account on it and no folder, as os.mkdir refuses one
    that exists. The sign-in only ever goes in a folder made here, as a login run in another would replace what it holds."""
    root = accounts_folder()
    os.makedirs(root, exist_ok=True)
    ids, slots = {a["id"] for a in data["accounts"]}, {a.get("slot") for a in data["accounts"]}
    number = 2
    while True:
        path = os.path.join(root, str(number))
        if str(number) not in ids and path not in slots:
            try:
                os.mkdir(path)
            except FileExistsError:
                pass
            else:
                with open(os.path.join(path, "README"), "w", encoding="utf-8") as f:
                    f.write(f"Claude account {number}, kept by the account-rotator mod.\n")
                return path
        number += 1


def sign_in(folder: str, as_json: bool) -> str | None:
    """The sign-in, on this terminal, for a person to approve in the browser: why it did not finish, or None. Under --json
    what it prints goes to stderr, so stdout stays one JSON object."""
    env = {**os.environ, SLOT_VAR: folder, "CLAUDE_CONFIG_DIR": folder}
    try:
        code = subprocess.run(["claude", "auth", "login", "--claudeai"], env=env, stdout=sys.stderr if as_json else None).returncode
    except OSError as error:
        return f"cannot run claude: {error.strerror or error}"
    return None if code == 0 else f"claude auth login exited {code}"


def add(data: dict, store: str, given: str | None, wait_s: float, as_json: bool) -> int:
    """Signs a new folder in, or takes one given, and asks a session to list it. A person approved that sign-in, and
    nobody read what the folder holds, so every way out after it keeps the folder and says how to ask again."""
    if not isinstance(data.get("store-id"), str):
        return no_store_id(store)
    stop_on_signals()
    try:
        folder = make_folder(data) if given is None else given
    except OSError as error:
        print(f"account-rotator: cannot make a folder under {accounts_folder()}: {error.strerror or error}; fix that, or see --help", file=sys.stderr)
        return EXIT_NO_STORE
    way_back = f"; {folder} is kept: account add --folder {folder} asks again"
    try:
        why = None if given is not None else sign_in(folder, as_json)
        if why is not None:
            print(f"account-rotator: the sign-in did not finish ({why}){way_back}", file=sys.stderr)
            return EXIT_NO_SIGN_IN
        # A sign-in takes minutes: the store-id as it stands now.
        store, data = read(store)
        check(data, store)
        store_id = data.get("store-id")
        if not isinstance(store_id, str):
            return no_store_id(store, way_back)
        fields = {"kind": "add", "slot": folder}
        code, result = session_answer(store, store_id, os.path.basename(folder), wait_s, fields, f"no session of the mod on {store} took", way_back)
    except StoreError as error:
        print(f"account-rotator: {error}{way_back}", file=sys.stderr)
        return EXIT_NO_STORE
    except KeyboardInterrupt:
        print(f"account-rotator: stopped, so any request is withdrawn; a session may have taken it in that same moment: run account list{way_back}", file=sys.stderr)
        return EXIT_CANCELLED
    if result is None:
        return code
    account = result.get("accountId") if isinstance(result.get("accountId"), str) else os.path.basename(folder)
    pick = result.get("pickId") if isinstance(result.get("pickId"), str) else None
    report(store, result, {"account": account, "folder": folder, "activeAccountId": pick, "message": result["message"]}, as_json)
    return 0


def parsers() -> tuple[argparse.ArgumentParser, argparse.ArgumentParser]:
    """The root parser, and the account group's, whose help a bare `account` prints."""
    root = argparse.ArgumentParser(
        prog="account-rotator",
        description="The account-rotator mod's Claude accounts, from a shell. Verbs: account list, account select, account use, account rm, account add.",
        epilog=EXITS,
    )
    groups = root.add_subparsers(dest="group", metavar="account")
    account = groups.add_parser("account", help="the Claude accounts the mod keeps", description="Verbs: account list, account select, account use, account rm, account add.", epilog=EXITS)
    verbs = account.add_subparsers(dest="verb", metavar="list|select|use|rm|add")
    listing = verbs.add_parser(
        "list",
        help="print each account's row as the switcher pane draws it",
        description=f"account list: print each account's row as the switcher pane draws it, then when the rows were written and where new sessions start. Reads the store, never writes it. --json prints Orca's envelope (orca account list --json) with the mod's own fields per account, and thisSessionAccountId: the account whose slot this process inherited with {SESSION_VAR}, as of when it started; a child that outlives its session still names it.",
        epilog=EXITS,
    )
    selecting = verbs.add_parser(
        "select",
        help="set the account new sessions start on, as the panel's New on does",
        description="account select: set the account new sessions start on, as the panel's New on does, through a session of the mod on the store, which applies the request within a minute. It never writes the store. A --plugin-dir or throwaway-config session keeps a store of its own and applies only a request read from that store (--store).",
        epilog=EXITS,
    )
    using = verbs.add_parser(
        "use",
        help="move the session running this to an account, as the panel's Use now does",
        description=f"account use: move the session running this to an account, as the panel's Use now does: in the Bash tool's foreground, while the command runs; run any other way (`!`, under a wrapper's name, a background Bash), within a minute, so a --wait under 60 can exit 3. While Claude in Chrome connects it refuses, exit 4. It never writes the store. It finds its session by {SESSION_VAR}, which the mod sets in its Bash children's environment; with it unset this exits 2. A --plugin-dir or throwaway-config session keeps a store of its own: pass it with --store.",
        epilog=EXITS,
    )
    removing = verbs.add_parser(
        "rm",
        help="sign an account out and drop it, as the panel's Remove does",
        description="account rm: sign an account out and drop it, its keys and its place as where new sessions start, as the panel's Remove does, through any session of the mod on the store. It never writes the store. Other sessions on that account are not moved; their next check finds its sign-in gone. A session on it that applies this moves off first, and answers not ok with no other account to take over, while Claude in Chrome connects, or when the sign-out fails, which keeps the account. Claude Code's own login is not the mod's: exit 2.",
        epilog=EXITS,
    )
    adding = verbs.add_parser(
        "add",
        help="sign a new account in through the browser, as the panel's + Add an account does",
        description="account add: sign a new account in through the browser, in this terminal, and list it, as the panel's + Add an account does. A person approves the sign-in, so with no terminal it exits 2. It makes the next free folder under ~/.claude/accounts, never one that exists; a session of the mod on the store lists it within a minute. Every way out after the sign-in, a failed one too, keeps the folder and names it; a later add takes the next number. A twin, a login some account may hold already, Claude Code's own login among them, exits 4 and stays signed in there with no account on it: the answer gives the sign-out command. A row whose organization no session has read counts as that login: ask again once a check has read it. --folder takes a folder already signed in, with no terminal and no sign-in: the way to ask again.",
        epilog=EXITS,
    )
    adding.add_argument("--folder", help="a numbered folder under ~/.claude/accounts that is signed in already: no sign-in runs, and no terminal is needed")
    wait_help = "seconds to wait for a session to take the request, above 0 and at most 300 (default 90; a session looks once a minute)"
    for verb in (selecting, using, removing):
        verb.add_argument("--account", required=True, help="the account: its id, its email (when one account has it), or system, the account on Claude Code's own login")
    for verb in (selecting, using, removing, adding):
        verb.add_argument("--wait", type=wait_seconds, default=90.0, help=wait_help)
    for verb in (listing, selecting, using, removing, adding):
        verb.add_argument("--agent", default="claude", help="the agent whose accounts these are: claude, the only one the mod keeps")
        verb.add_argument("--json", action="store_true", help="print Orca's JSON envelope instead of text")
        verb.add_argument("--store", help="the mod's store file (default: the newest " + STORE_GLOB + " holding accounts, under the Claude config folder)")
    return root, account


def main(argv: list[str] | None = None, *, now: float | None = None, zone: tzinfo | None = None) -> int:
    """`now` (epoch ms) and `zone` stand in for this machine's clock and zone, for the tests."""
    root, account = parsers()
    args = root.parse_args(argv)
    if args.group is None or args.verb is None:
        (root if args.group is None else account).print_help(sys.stderr)
        return EXIT_USAGE
    if args.agent != "claude":
        print(f"account-rotator: --agent {args.agent}: this mod keeps Claude accounts only; use --agent claude, or see --help", file=sys.stderr)
        return EXIT_USAGE
    if args.verb == "use" and not os.environ.get(SESSION_VAR):
        print(f"account-rotator: account use moves the session running it, and {SESSION_VAR} is unset: run it from the Bash tool of a session on this version of the mod, or see --help", file=sys.stderr)
        return EXIT_USAGE
    folder = None
    if args.verb == "add":
        if args.folder is None and (sys.stdin is None or not sys.stdin.isatty()):
            print("account-rotator: account add signs in through a browser, which a person approves, and this has no terminal: run it in a terminal, or pass --folder <path> for a folder already signed in, or see --help", file=sys.stderr)
            return EXIT_USAGE
        try:
            folder = None if args.folder is None else folder_given(args.folder)
        except UsageError as error:
            print(f"account-rotator: {error}", file=sys.stderr)
            return EXIT_USAGE
    try:
        store, data = read(args.store)
        check(data, store)
    except StoreError as error:
        print(f"account-rotator: {error}", file=sys.stderr)
        return EXIT_NO_STORE
    requesting = {"select": select, "use": use, "rm": remove}
    if args.verb in ("add", *requesting):
        try:
            if args.verb == "add":
                return add(data, store, folder, args.wait, args.json)
            return requesting[args.verb](data, store, args.account, args.wait, args.json)
        except KeyboardInterrupt:
            print("account-rotator: stopped, so any request is withdrawn; a session may have taken it in that same moment: run account list", file=sys.stderr)
            return EXIT_CANCELLED
    now_ms = time.time() * 1000 if now is None else now
    print(json.dumps(list_json(data, store, now_ms, zone), ensure_ascii=False, indent=2) if args.json else list_text(data, now_ms, zone))
    return 0


if __name__ == "__main__":
    sys.exit(main())
