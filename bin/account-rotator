#!/usr/bin/env python3
"""account-rotator: the account-rotator mod's Claude accounts from a shell, in the words of Orca's `orca account`.

    account-rotator account list [--agent claude] [--json] [--store PATH]

`list` prints each account's row as the switcher pane draws it, from the store's `rows` key, which every session of
the mod rewrites when a row changes: its times are stored as instants, rendered here at this clock and in this zone.
Then one line says when the rows were written and which account new sessions start on. It reads the store and never
writes it. Exit 0 listed, 1 no store or an unreadable one, 2 a usage error.
"""

# Read as text, so `str | None` is no error on a macOS python3 older than 3.10.
from __future__ import annotations

import argparse
import glob
import json
import math
import os
import sys
import time
import uuid
from datetime import datetime, tzinfo

STORE_GLOB = "account-rotator_claude-account-rotator-*.json"
EXIT_NO_STORE = 1
EXIT_USAGE = 2
MINUTE_MS = 60_000
OLDER_NOTE = "an older version of the mod stored some rows as text, their times as of when it wrote them"
EXITS = "Exit 0 listed, 1 no store or an unreadable one, 2 a usage error (an unknown flag or verb, --agent not claude)."


def is_number(value: object) -> bool:
    return isinstance(value, (int, float)) and not isinstance(value, bool)


def holds_accounts(path: str) -> bool:
    """Whether a file is a store: a JSON object holding an accounts list. A stray file of the store's name is not."""
    try:
        with open(path, encoding="utf-8") as f:
            data = json.load(f)
    except (OSError, ValueError):
        return False
    return isinstance(data, dict) and isinstance(data.get("accounts"), list)


def mtime(path: str) -> float:
    try:
        return os.path.getmtime(path)
    except OSError:
        return -1.0


def default_store() -> str | None:
    """The newest store of the installed mod in the Claude config folder; bin/account-rotator-launch picks it alike."""
    config = os.environ.get("CLAUDE_CONFIG_DIR") or os.path.join(os.path.expanduser("~"), ".claude")
    found = sorted(glob.glob(os.path.join(config, "plugins", "store", STORE_GLOB)), key=mtime, reverse=True)
    return next((path for path in found if holds_accounts(path)), None)


def clock_text(at_ms: float, zone: tzinfo | None) -> str:
    """HH:MM on a 24-hour clock in `zone`, else in this machine's own: hooks/model.ts clockText."""
    return datetime.fromtimestamp(at_ms / 1000, zone).strftime("%H:%M")


def reset_text(at_ms: float, now_ms: float) -> str:
    """The time until `at_ms`, as hooks/model.ts resetText says it, a half minute rounded up as JavaScript rounds."""
    minutes = max(0, math.floor((at_ms - now_ms) / MINUTE_MS + 0.5))
    days, hours, mins = minutes // 1440, minutes % 1440 // 60, minutes % 60
    if days > 0:
        return f"{days}d {hours}h {mins}m"
    return f"{hours}h {mins}m" if hours > 0 else f"{mins}m"


def line_text(line: object, now_ms: float, zone: tzinfo | None) -> str | None:
    """A stored line as text: its runs with each {clock} and {until} rendered; a string line as it was stored."""
    if isinstance(line, str):
        return line
    if not isinstance(line, list):
        return None
    text = []
    for run in line:
        if isinstance(run, str):
            text.append(run)
        elif isinstance(run, dict) and is_number(run.get("clock")):
            text.append(clock_text(run["clock"], zone))
        elif isinstance(run, dict) and is_number(run.get("until")):
            text.append(reset_text(run["until"], now_ms))
        else:
            return None
    return "".join(text)


def who(account: dict) -> str:
    """The account's name on its row's first line: hooks/model.ts rowOf."""
    if isinstance(account.get("email"), str):
        return account["email"]
    return "your normal account" if account.get("slot") == "" else "not signed in yet"


def account_lines(account: dict, rows: dict[str, object], now_ms: float, zone: tzinfo | None) -> tuple[list[str], bool]:
    """An account's lines, and whether an older version of the mod stored them."""
    stored = rows.get(account.get("id"))
    lines = [line_text(line, now_ms, zone) for line in stored] if isinstance(stored, list) else []
    if not lines or any(line is None for line in lines):
        return [f"{who(account)}  no row stored yet"], False
    return [line for line in lines if line is not None], any(isinstance(line, str) for line in stored)


def minutes_ago(at_ms: object, now_ms: float) -> str:
    return f"{round((now_ms - at_ms) / MINUTE_MS)} min ago" if is_number(at_ms) else "at an unknown time"


def footer(data: dict, now_ms: float, zone: tzinfo | None, has_older: bool) -> str:
    """When the rows were written, and which account new sessions start on, as bin/account-rotator-launch words it."""
    stored = data.get("rows")
    at = stored.get("at") if isinstance(stored, dict) else None
    written = f"rows written {clock_text(at, zone)} ({minutes_ago(at, now_ms)})" if is_number(at) else "no session has stored rows yet"
    pick = data.get("launch-slot")
    if isinstance(pick, dict) and isinstance(pick.get("id"), str):
        starts = f"new sessions start on account {pick['id']} ({pick.get('why', 'the setting picked it')}, picked {minutes_ago(pick.get('at'), now_ms)})"
    else:
        starts = "no account picked for new sessions"
    return "; ".join([written, starts, *([OLDER_NOTE] if has_older else [])])


def accounts_of(data: dict) -> list[dict]:
    return [a for a in data.get("accounts", []) if isinstance(a, dict) and isinstance(a.get("id"), str)]


def rows_by_id(data: dict) -> dict[str, object]:
    stored = data.get("rows")
    rows = stored.get("rows") if isinstance(stored, dict) else None
    return {r["id"]: r.get("lines") for r in rows or [] if isinstance(r, dict) and isinstance(r.get("id"), str)}


def list_text(data: dict, now_ms: float, zone: tzinfo | None) -> str:
    rows = rows_by_id(data)
    listed = [account_lines(a, rows, now_ms, zone) for a in accounts_of(data)]
    blocks = ["\n".join(lines) for lines, _ in listed]
    return "\n\n".join([*blocks, footer(data, now_ms, zone, any(older for _, older in listed))])


def list_json(data: dict, store: str, now_ms: float, zone: tzinfo | None) -> dict:
    """Orca's envelope (`orca account list --json`), with the mod's own fields per account."""
    rows = rows_by_id(data)
    accounts = []
    for a in accounts_of(data):
        lines, older = account_lines(a, rows, now_ms, zone)
        health = data.get(f"health:{a['id']}")
        accounts.append({
            "id": a["id"], "email": a.get("email"), "orgId": a.get("orgId"), "orgName": a.get("orgName"), "plan": a.get("plan"),
            "tier": a.get("tier"), "slot": a.get("slot"), "system": a.get("slot") == "",
            "health": health.get("kind") if isinstance(health, dict) else None, "lines": lines, "olderLines": older,
        })
    pick = data.get("launch-slot") if isinstance(data.get("launch-slot"), dict) else None
    active = pick.get("id") if pick is not None and isinstance(pick.get("id"), str) else None
    stored = data.get("rows")
    return {
        "id": str(uuid.uuid4()),
        "ok": True,
        "result": {
            "accounts": accounts, "activeAccountId": active, "activeAccountIdsByRuntime": {"host": active, "wsl": {}},
            "launchOn": data.get("launch-on"), "launchPick": pick,
        },
        "_meta": {"runtimeId": None, "store": store, "rowsAt": stored.get("at") if isinstance(stored, dict) else None},
    }


def parsers() -> tuple[argparse.ArgumentParser, argparse.ArgumentParser]:
    """The root parser, and the account group's, whose help a bare `account` prints."""
    root = argparse.ArgumentParser(
        prog="account-rotator",
        description="The account-rotator mod's Claude accounts, from a shell. Verbs: account list.",
        epilog=EXITS,
    )
    groups = root.add_subparsers(dest="group", metavar="account")
    account = groups.add_parser("account", help="the Claude accounts the mod keeps", description="Verbs: account list.", epilog=EXITS)
    verbs = account.add_subparsers(dest="verb", metavar="list")
    listing = verbs.add_parser(
        "list",
        help="print each account's row as the switcher pane draws it",
        description="account list: print each account's row as the switcher pane draws it, then when the rows were written and where new sessions start. Reads the store, never writes it. --json prints Orca's envelope (orca account list --json) with the mod's own fields per account.",
        epilog=EXITS,
    )
    listing.add_argument("--agent", default="claude", help="the agent whose accounts to list: claude, the only one the mod keeps")
    listing.add_argument("--json", action="store_true", help="print Orca's JSON envelope instead of text")
    listing.add_argument("--store", help="the mod's store file (default: the newest " + STORE_GLOB + " holding accounts, under the Claude config folder)")
    return root, account


def read_store(path: str) -> dict | str:
    """The store's data, or why it cannot be read."""
    try:
        with open(path, encoding="utf-8") as f:
            data = json.load(f)
    except (OSError, ValueError) as error:
        return f"cannot read {path}: {error}"
    return data if isinstance(data, dict) else f"{path} is not a store (its JSON is not an object)"


def main(argv: list[str] | None = None, *, now: float | None = None, zone: tzinfo | None = None) -> int:
    """`now` (epoch ms) and `zone` stand in for this machine's clock and zone, for the tests."""
    root, account = parsers()
    args = root.parse_args(argv)
    if args.group is None or args.verb is None:
        (root if args.group is None else account).print_help(sys.stderr)
        return EXIT_USAGE
    if args.agent != "claude":
        print(f"account-rotator: --agent {args.agent}: this mod keeps Claude accounts only; use --agent claude, or see --help", file=sys.stderr)
        return EXIT_USAGE
    store = args.store or default_store()
    if store is None or not os.path.isfile(store):
        print(f"account-rotator: no account-rotator store found ({store or STORE_GLOB}); start one Claude Code session with the mod first, or pass --store", file=sys.stderr)
        return EXIT_NO_STORE
    data = read_store(store)
    if isinstance(data, str):
        print(f"account-rotator: {data}", file=sys.stderr)
        return EXIT_NO_STORE
    now_ms = time.time() * 1000 if now is None else now
    print(json.dumps(list_json(data, store, now_ms, zone), ensure_ascii=False, indent=2) if args.json else list_text(data, now_ms, zone))
    return 0


if __name__ == "__main__":
    sys.exit(main())
